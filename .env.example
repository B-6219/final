# ─────────────────────────────────────────────────────────────────────────
# Chief Motors — environment variables
#
# Paste your real keys after the "=" on each line below, then restart
# `npm run dev` (Vite only reads these on startup). Nothing here is
# optional long-term, but the app will still run with these blank —
# it just won't be able to reach that particular service yet.
#
# This file is already git-ignored (see .gitignore) — safe to keep
# real secrets in it locally, just never commit it.
# ─────────────────────────────────────────────────────────────────────────

# --- Convex (database + backend functions) ---------------------------------
# Get this by running `npx convex dev` in this project — it creates a
# Convex project for you and prints/writes this URL automatically.
VITE_CONVEX_URL=

# --- Clerk (authentication) --------------------------------------------------
# Dashboard: https://dashboard.clerk.com -> your app -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=
# Secret key is only needed server-side (e.g. in a Convex action for
# webhooks) — never expose this with a VITE_ prefix. Kept here for
# convenience so it's in one place; move it to Convex's env settings
# (npx convex env set CLERK_SECRET_KEY ...) when you wire up webhooks.
CLERK_SECRET_KEY=

# --- Cloudinary (vehicle image storage) -------------------------------------
# Dashboard: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Only needed server-side for signed uploads/deletes — do not prefix VITE_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (card payments) --------------------------------------------------
# Dashboard: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=
# Secret key — server/action side only, never VITE_ prefixed.
STRIPE_SECRET_KEY=

# --- M-Pesa Daraja API (mobile money, Kenya) --------------------------------
# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# 'sandbox' while testing, 'production' when you go live
MPESA_ENV=sandbox
